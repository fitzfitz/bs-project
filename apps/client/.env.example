# =============================================================================
# The Barber Project — Client PWA Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- API ---
VITE_API_URL="http://localhost:8787/api"
VITE_ORG_SLUG="budis-barbershop"

# --- Pusher/Soketi Real-Time (optional) ---
# See docs/soketi_server_setup.md for full setup guide
# VITE_PUSHER_KEY="your-pusher-key"
# VITE_PUSHER_HOST="localhost"
# VITE_PUSHER_PORT="6001"
# VITE_PUSHER_USE_TLS="false"

# --- OneSignal Push Notifications (optional) ---
# Get from: https://onesignal.com > Your App > Settings > Keys & IDs
# See docs/onesignal_setup.md for full setup guide
# VITE_ONESIGNAL_APP_ID="your-onesignal-app-id"
