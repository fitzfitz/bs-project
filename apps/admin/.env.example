# =============================================================================
# The Barber Project — Admin Dashboard Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- API ---
VITE_API_URL="http://localhost:8787/api"
VITE_ORG_SLUG="budis-barbershop"

# --- Soketi / Pusher (WebSocket real-time queue updates) ---
# Must match the PUSHER_KEY and PUSHER_HOST from the API's .dev.vars
VITE_PUSHER_KEY="your-pusher-key"
VITE_PUSHER_HOST="ws.yourdomain.com"
VITE_PUSHER_PORT="443"
VITE_PUSHER_USE_TLS="true"
