# ── Database ──────────────────────────────────────────────
# Use host.docker.internal when PostgreSQL runs on the VPS host (not in Docker)
DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/barber_db

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change-me-minimum-32-characters-long
JWT_REFRESH_SECRET=change-me-minimum-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Pusher / Soketi ──────────────────────────────────────
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-key
PUSHER_SECRET=your-secret
PUSHER_CLUSTER=mt1
PUSHER_HOST=your-soketi-host
PUSHER_PORT=443
PUSHER_USE_TLS=true

# ── S3 / MinIO Media Storage ─────────────────────────────
# Required for file uploads (avatars, branch images, review photos, etc.)
# See docs/minio_server_setup.md for self-hosted MinIO setup
S3_ENDPOINT=http://your-minio-host:5555
S3_ACCESS_KEY=your-minio-access-key
S3_SECRET_KEY=your-minio-secret-key
S3_BUCKET=barber-media
S3_PUBLIC_URL=http://your-minio-host:5555/barber-media

# ── Xendit (optional — omit for CASH-only) ───────────────
# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_TOKEN=
