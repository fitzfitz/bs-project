# =============================================================================
# TMNG SaaS Platform — API Environment Variables
# Copy this file to .env and .dev.vars, then fill in your values.
# =============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/tmng_saas_db?schema=public"

# JWT Secrets (generate with: openssl rand -base64 48)
JWT_SECRET="your-jwt-secret-must-be-at-least-32-characters-long"
JWT_REFRESH_SECRET="your-refresh-secret-must-be-at-least-32-characters-long"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Environment
NODE_ENV="development"

# =============================================================================
# Pusher / Soketi (REQUIRED — real-time queue updates)
# =============================================================================
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_HOST="your-soketi-host"
PUSHER_PORT="443"
PUSHER_USE_TLS="true"
PUSHER_CLUSTER="mt1"

# =============================================================================
# S3 / MinIO (optional — media upload disabled when absent)
# =============================================================================
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# =============================================================================
# OneSignal (optional — push notifications logged when absent)
# =============================================================================
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# =============================================================================
# Xendit (optional — payment gateway, omit for CASH-only mode)
# =============================================================================
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
