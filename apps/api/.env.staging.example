# === Required ===
DATABASE_URL=postgresql://user:password@host:5432/tmng_staging
JWT_SECRET=min-32-char-secret-for-staging-environment
JWT_REFRESH_SECRET=min-32-char-refresh-secret-staging

# === Pusher / Soketi ===
PUSHER_APP_ID=staging-app
PUSHER_KEY=staging-key
PUSHER_SECRET=staging-secret
PUSHER_HOST=soketi.example.com
PUSHER_PORT=443
PUSHER_USE_TLS=true
PUSHER_CLUSTER=mt1

# === Optional: Google OAuth ===
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# === Optional: Xendit Payment Gateway ===
# XENDIT_SECRET_KEY=xnd_production_...
# XENDIT_WEBHOOK_TOKEN=your-webhook-callback-token

# === Optional: S3 / MinIO ===
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=tmng-media
# S3_PUBLIC_URL=https://s3.example.com/tmng-media

# === Optional: OneSignal ===
# ONESIGNAL_APP_ID=your-onesignal-app-id
# ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# === Optional: SMTP Email (scheduled report delivery) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com
