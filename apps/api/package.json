{
  "name": "@tmng/saas-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "lint": "echo \"no linter configured yet\"",
